# Database — pick one
# Option A: local Docker dev (matches compose.yml)
# DATABASE_URL=postgresql://myblog:myblog_dev@localhost:5432/myblog
# Option B: Neon (use the pooled connection string from the Neon console)
# DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL=

# Auth.js — generate with: bunx auth secret
AUTH_SECRET=

# OAuth Providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
